// FairBid schema. Money is integer cents plus a currency. Json columns hold
// data that is always read as one unit and never filtered on its own.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenderStatus {
  DRAFT
  OPEN
  CLOSED
  REVIEWING
  CLARIFYING
  PRICED
  SCORED
  AWARDED
  IN_DELIVERY
  COMPLETE
  CANCELLED
}

enum BidLineKind {
  goods
  shipping
  duty
  vat
  fees
}

enum ChannelKind {
  inapp
  whatsapp
  telegram
}

enum FlagKind {
  price_and_text
}

enum FlagReview {
  unreviewed
  confirmed
  dismissed
}

enum MilestoneStatus {
  pending
  confirmed
  captured
}

model Tender {
  id                 String       @id @default(uuid())
  title              String
  needText           String
  spec               Json
  budgetCents        Int
  currency           String       @default("EUR")
  destinationCountry String
  vatReclaimable     Boolean      @default(true)
  closesAt           DateTime
  status             TenderStatus @default(DRAFT)
  createdAt          DateTime     @default(now())
  // The buyer account that posted it. Only that buyer sees and runs the tender.
  buyerId            String?
  // Reference photos from the buyer, as resized JPEG data URLs. Prototype only:
  // move to object storage before real use.
  photos             Json         @default("[]")

  criteria       Criterion[]
  bids           Bid[]
  clarifications Clarification[]
  questions      TenderQuestion[]
  award          Award?
  events         Event[]
  chatPrompts    ChatPrompt[]

  @@index([buyerId])
}

model Criterion {
  id        String @id @default(uuid())
  tenderId  String
  name      String
  weightPct Int
  rubric    String

  tender Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  scores Score[]

  @@index([tenderId])
}

model Seller {
  id             String      @id
  name           String
  country        String
  paypalEmail    String
  channelKind    ChannelKind @default(inapp)
  channelAddress String?

  // FairBid's own bidding agent for this seller: what they sell, in their words, and whether it bids for them.
  agentBrief     String?
  agentOn        Boolean     @default(false)
  agentUpdatedAt DateTime?

  bids         Bid[]
  channelLinks ChannelLink[]
  linkCodes    ChannelLinkCode[]
  agentKeys    AgentKey[]
  questions    TenderQuestion[]
}

model Bid {
  id           String    @id @default(uuid())
  tenderId     String
  sellerId     String
  hsCode       String?
  hsConfidence Decimal?  @db.Decimal(3, 2)
  leadTimeDays Int
  notes        String
  // sha256 of the bid at submission, shown in the event log, so a sealed bid
  // can be shown unchanged when it is opened.
  sealedHash   String
  submittedAt  DateTime  @default(now())
  openedAt     DateTime?
  // Product photos, sealed with the price until the tender closes. Resized JPEG
  // data URLs in the prototype.
  photos       Json      @default("[]")

  tender          Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  seller          Seller           @relation(fields: [sellerId], references: [id])
  lines           BidLine[]
  scores          Score[]
  replies         Reply[]
  channelMessages ChannelMessage[]
  flags           Flag[]           @relation("FlagBid")
  pairedIn        Flag[]           @relation("FlagPairedBid")
  awards          Award[]

  @@unique([tenderId, sellerId])
  @@index([tenderId])
}

model BidLine {
  id          String      @id @default(uuid())
  bidId       String
  kind        BidLineKind
  amountCents Int
  // "seller", or the tariff row and its "as of" date for computed lines.
  source      String

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([bidId, kind])
}

model Clarification {
  id       String   @id @default(uuid())
  tenderId String
  question String
  sentTo   Json // seller ids, so "same question to every relevant bidder" is checkable
  sentAt   DateTime @default(now())

  tender          Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  replies         Reply[]
  channelMessages ChannelMessage[]

  @@index([tenderId])
}

model Reply {
  id              String      @id @default(uuid())
  clarificationId String
  bidId           String
  channel         ChannelKind
  body            String
  receivedAt      DateTime    @default(now())

  clarification Clarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  bid           Bid           @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([clarificationId, bidId])
}

// A seller's chat that also receives their clarification questions (Telegram chat id or
// WhatsApp number). One per channel per seller; the in-app inbox needs none. The older
// Seller.channelKind and channelAddress columns are unused and kept only so no applied
// migration changes.
model ChannelLink {
  id       String      @id @default(uuid())
  sellerId String
  kind     ChannelKind
  address  String
  linkedAt DateTime    @default(now())

  seller   Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages ChannelMessage[]

  @@unique([sellerId, kind])
  @@unique([kind, address])
}

// A one-time code that proves a chat belongs to a seller who is signed in. Only a
// sha256 of the code is stored; it is deleted when used or after it expires.
model ChannelLinkCode {
  codeHash  String      @id
  sellerId  String
  kind      ChannelKind
  expiresAt DateTime

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, kind])
}

// A key a seller's own AI agent sends to /api/mcp. Only a sha256 of the key is stored;
// the seller sees the key once, when it is made. Revoked keys stay, so the record shows
// which agent acted when.
model AgentKey {
  id         String    @id @default(uuid())
  sellerId   String
  keyHash    String    @unique
  prefix     String
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

// A question as it was sent to a chat, so a reply to that message finds its question.
model ChannelMessage {
  id              String   @id @default(uuid())
  linkId          String
  clarificationId String
  bidId           String
  externalId      String
  sentAt          DateTime @default(now())

  link          ChannelLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clarification Clarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  bid           Bid           @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([linkId, externalId])
  @@index([linkId, sentAt])
}

model Score {
  id          String @id @default(uuid())
  bidId       String
  criterionId String
  score       Int
  reason      String

  bid       Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([bidId, criterionId])
}

model Flag {
  id           String     @id @default(uuid())
  bidId        String
  pairedBidId  String
  kind         FlagKind
  similarity   Decimal    @db.Decimal(4, 3)
  evidence     Json
  reason       String
  reviewStatus FlagReview @default(unreviewed)

  bid       Bid @relation("FlagBid", fields: [bidId], references: [id], onDelete: Cascade)
  pairedBid Bid @relation("FlagPairedBid", fields: [pairedBidId], references: [id], onDelete: Cascade)

  @@unique([bidId, pairedBidId])
}

model Award {
  id        String    @id @default(uuid())
  tenderId  String    @unique
  bidId     String
  // The whole order: goods and shipping to the door. Over 28 days of delivery it is
  // held one phase at a time (src/lib/phases.ts), so no single hold covers all of it.
  holdCents Int
  awardedAt DateTime  @default(now())
  // Set when the buyer ended the order between phases, with no hold in place.
  endedAt   DateTime?

  tender         Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bid            Bid             @relation(fields: [bidId], references: [id])
  authorizations Authorization[]
  milestones     Milestone[]
}

// One PayPal hold. An award has one per phase, plus one more for each hold that
// lapsed before its phase was paid and was replaced. `seq` counts them in order.
model Authorization {
  id            String    @id @default(uuid())
  awardId       String
  phase         Int       @default(1)
  seq           Int       @default(1)
  createdAt     DateTime  @default(now())
  paypalOrderId String    @unique
  paypalAuthId  String?   @unique
  amountCents   Int
  expiresAt     DateTime?
  status        String

  award    Award     @relation(fields: [awardId], references: [id], onDelete: Cascade)
  captures Capture[]

  @@unique([awardId, seq])
}

model Capture {
  id              String  @id @default(uuid())
  authorizationId String
  milestoneId     String  @unique
  paypalCaptureId String? @unique
  amountCents     Int
  finalCapture    Boolean @default(false)
  status          String
  // PayPal's reason when the status is PENDING or DENIED (its status_details.reason).
  statusReason    String?
  // Refunded by the seller from their own PayPal account, reported by webhook.
  refundedCents   Int     @default(0)

  authorization Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  milestone     Milestone     @relation(fields: [milestoneId], references: [id])
}

model Milestone {
  id      String          @id @default(uuid())
  awardId String
  name    String
  pct     Int
  seq     Int
  status  MilestoneStatus @default(pending)
  // Days after the award when the step is expected, and the phase whose hold pays it.
  dueDay  Int?
  phase   Int             @default(1)

  award   Award    @relation(fields: [awardId], references: [id], onDelete: Cascade)
  capture Capture?

  @@unique([awardId, seq])
}

// People who sign in with an email and password. The demo accounts are seeded
// here too, with the same ids as DEMO_USERS, so either way of signing in lands
// on the same account. Only a scrypt hash of the password is stored.
model Account {
  id           String   @id
  email        String   @unique
  name         String
  role         String // "buyer" | "seller"
  sellerId     String?
  detail       String
  passwordHash String
  createdAt    DateTime @default(now())

  channelLinks BuyerChannelLink[]
  linkCodes    BuyerLinkCode[]
}

// Hash-chained per tender. See src/lib/audit.ts.
model Event {
  id       String   @id @default(uuid())
  tenderId String
  seq      Int
  actor    String
  kind     String
  payload  Json
  prevHash String
  hash     String
  at       DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, seq])
}

// PayPal webhook deliveries already handled. PayPal retries until it gets a 2xx and
// may deliver the same event twice; the id makes the second delivery a no-op.
model WebhookEvent {
  id         String   @id
  eventType  String
  receivedAt DateTime @default(now())
}

// A duty rule. Rows with an origin were looked up for that exact customs code and
// country of origin (Easyship) and are verified; the rest are broad assumptions a bid
// may borrow, and a borrowed rate is shown with a warning.
model TariffRate {
  id            String   @id @default(uuid())
  hsPrefix      String
  destination   String
  // Country the goods are made in (ISO alpha-2), or "" for a rule that ignores origin.
  origin        String   @default("")
  dutyPct       Decimal  @db.Decimal(5, 2)
  vatPct        Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime
  source        String

  @@unique([hsPrefix, destination, origin, effectiveFrom])
}

// A seller's question about an open tender, asked before bidding (by the seller or their agent).
// The answer is published to every bidder, never only the one who asked, and the asker stays
// anonymous to the other sellers. The buyer's AI answers from the tender when it can; otherwise
// the buyer does. A question never changes the tender, and answers cannot reveal a bid.
model TenderQuestion {
  id         String    @id @default(uuid())
  tenderId   String
  sellerId   String
  question   String
  answer     String?
  // "ai" when the buyer's AI answered from the tender, "buyer" when the buyer wrote it.
  answeredBy String?
  askedAt    DateTime  @default(now())
  answeredAt DateTime?

  tender          Tender                @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  seller          Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channelMessages BuyerChannelMessage[]

  @@index([tenderId])
}

// A buyer's linked chat (Telegram), kept apart from sellers' links so the seller path is unchanged.
// A chat belongs to one buyer account: the last to prove it holds it.
model BuyerChannelLink {
  id        String      @id @default(uuid())
  accountId String
  kind      ChannelKind
  address   String
  linkedAt  DateTime    @default(now())

  account  Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages BuyerChannelMessage[]

  @@unique([accountId, kind])
  @@unique([kind, address])
}

// A one-time code a signed-in buyer sends from the chat to link it. Only a sha256 is stored.
model BuyerLinkCode {
  codeHash  String      @id
  accountId String
  kind      ChannelKind
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind])
}

// A message sent to a buyer's chat, so a reply to it finds the seller question it answers.
model BuyerChannelMessage {
  id               String   @id @default(uuid())
  linkId           String
  tenderQuestionId String?
  externalId       String
  sentAt           DateTime @default(now())

  link     BuyerChannelLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  question TenderQuestion?  @relation(fields: [tenderQuestionId], references: [id], onDelete: Cascade)

  @@unique([linkId, externalId])
}

// A message the bot sent that asks for typed words, such as "Type your question about this
// tender". A reply to it does what `action` says on `tenderId`. Whose words they are comes
// from the chat's own link, never from this row.
model ChatPrompt {
  id         String      @id @default(uuid())
  kind       ChannelKind
  address    String
  externalId String
  action     String
  tenderId   String
  createdAt  DateTime    @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([kind, address, externalId])
}

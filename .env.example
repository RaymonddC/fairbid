# Copy to .env for local dev. On Cloud Run these come from Secret Manager and
# deploy.yml. Real values never enter the repo.

# ── Core ─────────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml. Bound to 127.0.0.1 only.
DATABASE_URL="postgresql://fairbid:fairbid@127.0.0.1:5434/fairbid?schema=public"

# Signs the session cookie. Required, no fallback. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand--base64-32

# Password of the seeded demo accounts (anna@fairbid.demo, sari@fairbid.demo).
# Printed on the login page for judges. Defaults to fairbid-demo.
DEMO_PASSWORD=

# Public origin of this app, with no trailing slash. Twilio signs the exact
# public URL it called, and Cloud Run terminates TLS, so a URL rebuilt from the
# request would reject every genuine webhook.
PUBLIC_BASE_URL=http://localhost:3000

# ── PayPal ───────────────────────────────────────────────────────────────────
# Anything other than "sandbox" refuses to run. See src/lib/paypal/client.ts.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# The id PayPal returned when the webhook was registered (DEPLOY.md, "After the first
# deploy"). Without it, every webhook is rejected and the app runs on its own records.
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID. Baked into the browser bundle at build time,
# so on Cloud Run it is a Docker build arg, not a runtime variable.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# The sandbox business account that receives Sari's payments. The seed and the
# Reset demo button write it onto seller-d; PayPal refuses an unknown payee.
SELLER_D_PAYPAL_EMAIL=

# ── AI ───────────────────────────────────────────────────────────────────────
# The five AI roles run on Gemini through Vertex AI, signed in with Google
# credentials (on Cloud Run, the service account; locally,
# `gcloud auth application-default login`). Empty project: every role answers
# from its scripted fixture.
GOOGLE_CLOUD_PROJECT=
# "global" is where Gemini 3.8 Flash answers.
GOOGLE_CLOUD_LOCATION=global
# Empty means gemini-3.8-flash, with gemini-2.5-flash tried once if it fails.
AI_MODEL=
# "false" turns the AI off without removing the project.
AI_ENABLED=

# ── Duty rates ───────────────────────────────────────────────────────────────
# Easyship API token (Tax & Duties scope only). With it, each bid's duty rate is
# looked up once for its customs code and country of origin and kept. Empty: bids
# are priced on the seeded demo rates, marked "borrowed" on screen. Production
# reads it from the secret fairbid-easyship-token.
EASYSHIP_TOKEN=
# Empty means https://public-api.easyship.com. The sandbox
# (https://public-api-sandbox.easyship.com) returns illustrative rates only.
EASYSHIP_API_URL=

# ── Seller agents ────────────────────────────────────────────────────────────
# Comma-separated sellerId:key pairs for /api/mcp. Keys need 24+ characters:
#   seller-a:$(openssl rand -hex 24),seller-b:...,seller-c:...,seller-d:...
MCP_SELLER_KEYS=

# ── Clarification channels (optional) ────────────────────────────────────────
# The in-app inbox always works. A channel is off unless every one of its variables
# is set. See DEPLOY.md, "Message channels".
#
# Telegram: make a bot with @BotFather. Webhook secret: 16-256 characters of
# A-Z a-z 0-9 _ - (openssl rand -hex 24). Register the webhook with
# `npm run channels:telegram -- set` once the app is reachable over https.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# The bot's username, without the @. Builds the t.me link on the seller's page.
TELEGRAM_BOT_USERNAME=
#
# WhatsApp through Twilio. Off unless WHATSAPP_ENABLED=true: a Twilio trial account cannot
# send, so it stays off until the account is upgraded (DECISIONS.md).
WHATSAPP_ENABLED=
# The sandbox is enough: recipients first send the sandbox
# the "join <word>" message from their phone. Set the sandbox's "when a message
# comes in" URL to <PUBLIC_BASE_URL>/api/webhooks/whatsapp (HTTP POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number, for example +14155238886.
TWILIO_WHATSAPP_FROM=
# Phone numbers (E.164, separated by semicolons) that may link a WhatsApp chat. Empty means
# nobody can, so a stranger who finds the sandbox number cannot attach a chat.
CHANNEL_ALLOWLIST=
